{
  "name": "padelconnect",
  "version": "1.0.0",
  "description": "Plateforme multi-tenant de mise en relation de joueurs de padel",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "predev:backend": "node -e \"const { execSync } = require('child_process'); try { const r = execSync('netstat -ano | findstr :4000').toString(); const pid = r.trim().split(/\\s+/).pop(); if(pid && !isNaN(pid)) execSync('taskkill /F /PID ' + pid); } catch(e) {}\"",
    "dev:backend": "nodemon src/app.js",
    "dev:frontend": "cd client && npm run dev",
    "kill-port": "for /f \"tokens=5\" %a in ('netstat -ano ^| findstr :4000') do taskkill /F /PID %a",
    "start": "node src/app.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/generative-ai": "^0.24.1",
    "@sendinblue/client": "^3.3.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "groq-sdk": "^1.2.1",
    "helmet": "^7.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "openai": "^6.39.1",
    "pg": "^8.12.0",
    "resend": "^4.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleNameMapper": {
      "^resend$": "<rootDir>/__mocks__/resend.js",
      "^openai$": "<rootDir>/__mocks__/openai.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "/migrations/",
      "/seeds/",
      "/src/emails/",
      "/src/features/ai/",
      "/src/features/contact/",
      "/src/features/friendships/",
      "/src/features/manager/",
      "/src/features/messages/",
      "/src/features/pia/",
      "/src/features/search/",
      "/src/features/subscriptions/"
    ]
  }
}
