{
  "name": "padelconnect",
  "version": "1.0.0",
  "description": "Plateforme multi-tenant de mise en relation de joueurs de padel",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon src/app.js",
    "dev:frontend": "cd client && npm run dev",
    "start": "node src/app.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.12.0",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleNameMapper": {
      "^resend$": "<rootDir>/__mocks__/resend.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "/migrations/",
      "/seeds/"
    ]
  }
}
